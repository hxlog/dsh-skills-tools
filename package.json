{
  "name": "dsh-skills-tools",
  "version": "1.3.0",
  "type": "module",
  "description": "DeepSeek Harness 的 Skills 管理器：从 Git 仓库导入技能，按仓库分组管理，随时启用、停用、补齐与查看内容。",
  "icon": "icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client/client.js",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "test:manager": "node scripts/manager-test.mjs",
    "test:provider": "node scripts/provider-test.mjs",
    "ci-check": "node scripts/ci-check.mjs",
    "test:network": "node scripts/network-sparse-test.mjs",
    "verify:dsh-go": "node scripts/verify-dsh-go.mjs",
    "verify:listings": "node scripts/verify-listings.mjs"
  },
  "license": "MIT",
  "author": "Xingyu Liu <xingyuliu@outlook.sg>",
  "homepage": "https://github.com/hxlog/dsh-skills-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxlog/dsh-skills-tools.git"
  },
  "bugs": {
    "url": "https://github.com/hxlog/dsh-skills-tools/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "skills",
    "agent-skills",
    "skill-manager",
    "cursor",
    "settings"
  ],
  "publishConfig": {
    "access": "public"
  }
}
