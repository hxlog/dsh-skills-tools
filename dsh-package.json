{
  "manifest_version": 2,
  "type": "plugin",
  "id": "hxlog/dsh-skills-tools",
  "version": "1.1.0",
  "channel": "stable",
  "name": "Skills管理器",
  "description": "DeepSeek Harness 的 Skills 管理器：从 Git 仓库导入技能，按仓库分组管理，随时启用、停用、补齐与查看内容。",
  "runtime": {
    "type": "plugin"
  },
  "entrypoints": {
    "bundle": "cordis.patch.yml"
  },
  "capabilities": [
    "skills.management",
    "skills.provider",
    "git.import",
    "settings.panel"
  ],
  "permissions": [
    "fs.read",
    "fs.write",
    "network",
    "process.spawn"
  ],
  "dependencies": [],
  "compatibility": {
    "os": [
      "linux",
      "darwin",
      "win32"
    ],
    "node": ">=22.13.0"
  },
  "publisher": {
    "id": "hxlog",
    "provider": "github",
    "url": "https://github.com/hxlog"
  },
  "security": {},
  "metadata": {
    "category": "tools",
    "tags": [
      "skills",
      "skill-manager",
      "agent-skills",
      "git",
      "settings",
      "dsh-plugin"
    ],
    "repository": "hxlog/dsh-skills-tools",
    "homepage": "https://github.com/hxlog/dsh-skills-tools"
  },
  "source": {
    "provider": "github",
    "repo": "hxlog/dsh-skills-tools",
    "url": "https://github.com/hxlog/dsh-skills-tools"
  }
}
